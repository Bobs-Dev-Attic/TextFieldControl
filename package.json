{
  "name": "textfieldcontrol",
  "version": "1.0.0",
  "description": "Dynamics 365 PCF Text Field Control with custom label color",
  "scripts": {
    "build": "pcf-scripts build",
    "clean": "pcf-scripts clean",
    "rebuild": "pcf-scripts rebuild",
    "start": "pcf-scripts start",
    "start:watch": "pcf-scripts start watch",
    "refreshTypes": "pcf-scripts refreshTypes",
    "test": "jest"
  },
  "dependencies": {
    "pcf-scripts": "^1",
    "pcf-start": "^1"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "@types/powerapps-component-framework": "^1.3.18",
    "jest": "^29",
    "jest-environment-jsdom": "^29",
    "ts-jest": "^29",
    "typescript": "~4.9"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "esModuleInterop": true
          }
        }
      ]
    },
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.js"
    }
  }
}
