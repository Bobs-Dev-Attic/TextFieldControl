<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="XRMatic"
           constructor="TextFieldControl"
           version="1.0.0"
           display-name-key="TextFieldControl_Display_Key"
           description-key="TextFieldControl_Desc_Key"
           control-type="standard"
           api-version="1.3.3">
    <external-service-usage enabled="false">
    </external-service-usage>

    <!-- The text value bound to the field in the form -->
    <property name="value"
              display-name-key="value_Display_Key"
              description-key="value_Desc_Key"
              of-type="SingleLine.Text"
              usage="bound"
              required="true" />

    <!-- Custom label text shown above the input -->
    <property name="labelText"
              display-name-key="labelText_Display_Key"
              description-key="labelText_Desc_Key"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <!-- Label text color – accepts any valid CSS color (e.g. "#c00000" or "red") -->
    <property name="labelColor"
              display-name-key="labelColor_Display_Key"
              description-key="labelColor_Desc_Key"
              of-type="SingleLine.Text"
              usage="input"
              required="false" />

    <resources>
      <code path="index.ts" order="1" />
      <css path="css/TextFieldControl.css" order="1" />
    </resources>
  </control>
</manifest>
