{
  "compilerOptions": {
    "target": "ES6",
    "module": "ES6",
    "lib": ["ES6", "DOM"],
    "outDir": "out/controls/TextFieldControl",
    "rootDir": "TextFieldControl",
    "typeRoots": ["node_modules/@types"],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "strict": false,
    "noUnusedLocals": false
  },
  "include": [
    "TextFieldControl/**/*"
  ],
  "exclude": [
    "TextFieldControl/__tests__/**/*",
    "node_modules"
  ]
}
